{
  "schema_version": 1,
  "cluster_name": "cluster-hw-llm-optimization",
  "local_node": "torre",
  "gateway": {
    "host": "127.0.0.1",
    "port": 1235,
    "upstream_url": "http://127.0.0.1:1234",
    "code_profile": "smart-first",
    "token": "<GENERATED_GATEWAY_TOKEN>",
    "cors_origins": []
  },
  "peer": {
    "port": 1236,
    "token": "<GENERATED_PEER_TOKEN>",
    "sync_dir": "<SHARED_SYNC_DIR>",
    "default_mode": "auto",
    "host_aliases": {},
    "openclaw": {
      "enabled": true,
      "primary_node": "torre",
      "witness_node": "raspberrypi",
      "responder": "antigravity",
      "agy_autonomous": true,
      "agy_cwd": "~",
      "port": 18789,
      "lease_ttl_s": 30,
      "probe_interval_s": 10,
      "failures_before_failover": 3
    }
  },
  "nodes": {
    "torre": {
      "label": "torre",
      "role": "desktop-cuda-workstation",
      "os": "windows+wsl",
      "base_url": "http://127.0.0.1:1234",
      "peer_url": "http://<TORRE_TAILSCALE_IP>:1236",
      "model_prefixes": ["t-", "text-embedding-t-"],
      "hardware": {
        "cpu": "AMD Ryzen 9 5950X (16C/32T)",
        "motherboard": "ASUS ROG STRIX X570-E GAMING",
        "ram": "32 GiB DDR4-3600 CL14 (4x8 GiB dual-rank/ch)",
        "gpu": "NVIDIA GeForce RTX 3080 Ti (12 GiB GDDR6X)",
        "vram_gib": 12.0,
        "memory_cap_gib": 11.75,
        "stock_bw_gbs": 788.48,
        "oc_bw_gbs": 831.81,
        "peak_tflops_fp16": 115.0
      },
      "default_gpu_oc": {
        "power_limit_pct": 100,
        "power_limit_w": 350,
        "vram_offset_mhz": 500,
        "vram_clock_mhz": 10001,
        "vf_target_mhz": 1770,
        "vf_target_mv": 875,
        "vf_cap_mhz": 1785
      },
      "verify_models": [
        {"key": "t-code-chat", "prefills": [2048, 4096], "extra_body": {}},
        {"key": "t-vision-context", "prefills": [2048, 8192], "extra_body": {"reasoning_effort": "none"}}
      ],
      "paths": {
        "lmstudio_home": "<LMSTUDIO_HOME>",
        "lms_cli": "<LMS_CLI>",
        "win_python": "<WIN_PYTHON>",
        "afterburner_cfg": "<AFTERBURNER_PROFILE_CFG>"
      }
    },
    "portatil": {
      "label": "portatil",
      "role": "laptop-unified-igpu",
      "os": "windows+wsl",
      "base_url": "http://<PORTATIL_TAILSCALE_IP>:1234",
      "peer_url": "http://<PORTATIL_TAILSCALE_IP>:1236",
      "model_prefixes": ["p-", "text-embedding-p-"],
      "hardware": {
        "cpu": "Intel Core Ultra 7 258V",
        "ram": "32 GiB LPDDR5x-8533 unified",
        "gpu": "Intel Arc 140V iGPU (75% Shared Memory Override)",
        "vram_gib": 24.0,
        "memory_cap_gib": 24.0,
        "est_bw_gbs": 110.0,
        "peak_tflops_fp16": 33.0
      },
      "verify_models": [
        {"key": "p-battery-chat", "prefills": [2048, 4096], "extra_body": {"reasoning_effort": "none"}},
        {"key": "p-agent-moe-alt", "prefills": [2048, 4096], "extra_body": {"reasoning_effort": "none"}}
      ],
      "paths": {
        "lmstudio_home": "<PORTATIL_LMSTUDIO_HOME>",
        "lms_cli": "<PORTATIL_LMS_CLI>"
      }
    },
    "raspberrypi": {
      "label": "raspberrypi",
      "role": "edge-arm-witness",
      "os": "linux",
      "base_url": "",
      "peer_url": "http://<RASPBERRYPI_TAILSCALE_IP>:1236",
      "ssh_target": "<USER>@<RASPBERRYPI_TAILSCALE_IP>",
      "model_prefixes": [],
      "hardware": {
        "board": "Raspberry Pi 2 Model B",
        "cpu": "ARMv7 Cortex-A7 (armv7l)",
        "ram": "1 GiB"
      }
    },
    "arduq": {
      "label": "arduq",
      "role": "edge-dual-mpu-mcu",
      "os": "linux",
      "base_url": "",
      "peer_url": "http://<ARDUQ_TAILSCALE_IP>:1236",
      "ssh_target": "arduino@<ARDUQ_TAILSCALE_IP>",
      "model_prefixes": [],
      "hardware": {
        "board": "Arduino UNO Q (Dual Processor)",
        "mpu": "Qualcomm Dragonwing QRB2210 (aarch64 Linux)",
        "mcu": "STM32U585 (Cortex-M33)"
      }
    }
  }
}
